/* 音频生成进度组件样式 */

.audio-progress-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999; /* 大幅提高优先级 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.7); /* 直接设置半透明背景，取代遮罩层 */
}

.progress-modal {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: modalSlideIn 0.3s ease-out;
  z-index: 100000; /* 确保模态框在最顶层 */
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 进度头部 */
.progress-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.progress-icon {
  margin-right: 20rpx;
}

.audio-wave-icon {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  width: 48rpx;
  height: 48rpx;
}

.wave-bar {
  width: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  animation: waveAnimation 1.5s ease-in-out infinite;
}

.wave-1 { height: 20rpx; animation-delay: 0s; }
.wave-2 { height: 32rpx; animation-delay: 0.2s; }
.wave-3 { height: 24rpx; animation-delay: 0.4s; }
.wave-4 { height: 16rpx; animation-delay: 0.6s; }

@keyframes waveAnimation {
  0%, 100% { transform: scaleY(0.5); opacity: 0.7; }
  50% { transform: scaleY(1); opacity: 1; }
}

.progress-title {
  flex: 1;
}

.title-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.subtitle-text {
  display: block;
  font-size: 24rpx;
  color: #666666;
  opacity: 0.8;
}

/* 整体进度 */
.overall-progress {
  margin-bottom: 32rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
}

.progress-percentage {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.progress-bar-container {
  margin-bottom: 12rpx;
}

.progress-bar-background {
  height: 12rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

.progress-bar-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(255, 255, 255, 0.6) 50%, 
    transparent 100%);
  animation: progressGlow 2s infinite;
}

@keyframes progressGlow {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.progress-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #666666;
}

.stat-item {
  white-space: nowrap;
}

.stat-divider {
  opacity: 0.5;
}

/* 当前状态 */
.current-status {
  background: rgba(102, 126, 234, 0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #333333;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

.status-indicator.processing {
  background: linear-gradient(45deg, #667eea, #764ba2);
}

.status-indicator.completed {
  background: #52c41a;
}

.status-indicator.failed {
  background: #ff4d4f;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

.current-slide {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.slide-icon {
  font-size: 32rpx;
}

.slide-info {
  flex: 1;
}

.slide-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slide-index {
  font-size: 22rpx;
  color: #666666;
}

.slide-progress {
  margin-top: 12rpx;
}

.slide-progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.slide-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.slide-progress-text {
  font-size: 20rpx;
  color: #666666;
}

/* 详细步骤 */
.progress-steps {
  margin-bottom: 24rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(102, 126, 234, 0.1);
  transition: all 0.3s ease;
}

.step-item:last-child {
  border-bottom: none;
}

.step-item.completed {
  opacity: 0.7;
}

.step-item.processing {
  background: rgba(102, 126, 234, 0.03);
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
  border: none;
}

.step-item.failed {
  background: rgba(255, 77, 79, 0.05);
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
  border: none;
}

.step-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-dot {
  width: 12rpx;
  height: 12rpx;
  background: #e9ecef;
  border-radius: 50%;
}

.step-loading {
  width: 16rpx;
  height: 16rpx;
}

.loading-spinner {
  width: 100%;
  height: 100%;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  border-top: 2rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.step-check {
  color: #52c41a;
  font-size: 20rpx;
  font-weight: bold;
}

.step-error {
  color: #ff4d4f;
  font-size: 20rpx;
  font-weight: bold;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.step-description {
  font-size: 20rpx;
  color: #666666;
  opacity: 0.8;
}

.step-time {
  font-size: 20rpx;
  color: #52c41a;
  flex-shrink: 0;
}

/* 生成信息 */
.generation-info {
  background: rgba(248, 249, 250, 0.8);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-label {
  font-size: 22rpx;
  color: #666666;
}

.info-value {
  font-size: 22rpx;
  font-weight: 500;
  color: #333333;
}

/* 操作按钮 */
.progress-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.action-btn.secondary {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.action-btn.danger {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.action-btn:active {
  transform: scale(0.98);
}

/* 错误信息 */
.error-message {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.error-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.error-content {
  flex: 1;
}

.error-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #ff4d4f;
  margin-bottom: 8rpx;
}

.error-text {
  font-size: 22rpx;
  color: #ff7875;
  line-height: 1.4;
}

.retry-btn {
  background: linear-gradient(135deg, #ff7875 0%, #ff4d4f 100%);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 完成状态 */
.completion-status {
  text-align: center;
  padding: 24rpx 0;
}

.success-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.success-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
  margin-bottom: 8rpx;
}

.success-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .progress-modal {
    margin: 20rpx;
    padding: 32rpx 24rpx;
  }
  
  .progress-actions {
    flex-direction: column;
  }
  
  .action-btn {
    flex: none;
  }
}