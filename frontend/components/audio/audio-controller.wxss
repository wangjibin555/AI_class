/* components/audio/audio-controller.wxss */

.audio-controller {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  /* backdrop-filter: blur(20px); 移除不兼容的模糊效果 */
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx 20rpx 20rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
  color: white;
}

/* 主控制面板 */
.main-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 播放控制 */
.play-control {
  flex-shrink: 0;
}

.control-btn {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  transition: all 0.3s ease;
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
}

.control-btn:hover,
.control-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.05);
}

.play-btn {
  width: 100rpx;
  height: 100rpx;
  font-size: 32rpx;
}

.control-icon {
  font-size: inherit;
}

/* 进度信息 */
.progress-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin: 0 20rpx;
}

.time-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  min-width: 80rpx;
  text-align: center;
}

.progress-container {
  flex: 1;
  height: 40rpx;
  display: flex;
  align-items: center;
}

.progress-slider {
  width: 100%;
  height: 6rpx;
}

/* 功能控制组 */
.function-controls {
  display: flex;
  gap: 15rpx;
  flex-shrink: 0;
}

.control-group {
  position: relative;
}

.speed-btn,
.volume-btn {
  width: 70rpx;
  height: 70rpx;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.control-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 面板样式 */
.speed-panel,
.volume-panel {
  position: absolute;
  bottom: 100%;
  right: 0;
  margin-bottom: 15rpx;
  background: rgba(0, 0, 0, 0.9);
  border-radius: 15rpx;
  padding: 20rpx;
  min-width: 200rpx;
  /* backdrop-filter: blur(20px); 移除不兼容的模糊效果 */
  animation: panelFadeIn 0.3s ease;
}

@keyframes panelFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.panel-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
  text-align: center;
  color: white;
}

/* 速度选择 */
.speed-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.speed-option {
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  padding: 10rpx 15rpx;
  font-size: 24rpx;
  color: white;
  min-width: 60rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.speed-option.active {
  background: #007bff;
  border-color: #007bff;
  transform: scale(1.05);
}

.speed-option:hover,
.speed-option:active {
  background: rgba(255, 255, 255, 0.2);
}

/* 音量控制 */
.volume-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.volume-slider {
  flex: 1;
  height: 6rpx;
}

.volume-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  min-width: 60rpx;
  text-align: right;
}

/* 音频状态指示器 */
.audio-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.status-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.wave-animation {
  display: flex;
  gap: 4rpx;
  align-items: end;
}

.wave {
  width: 6rpx;
  background: #28a745;
  border-radius: 3rpx;
  animation: wave 1.5s ease-in-out infinite;
}

.wave1 {
  height: 20rpx;
  animation-delay: 0s;
}

.wave2 {
  height: 30rpx;
  animation-delay: 0.2s;
}

.wave3 {
  height: 25rpx;
  animation-delay: 0.4s;
}

@keyframes wave {
  0%, 100% {
    transform: scaleY(0.5);
  }
  50% {
    transform: scaleY(1);
  }
}

.status-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 同步状态 */
.sync-status {
  position: absolute;
  top: -40rpx;
  right: 20rpx;
  background: rgba(40, 167, 69, 0.9);
  border-radius: 20rpx;
  padding: 8rpx 15rpx;
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
}

.sync-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sync-icon {
  font-size: 20rpx;
}

.sync-text {
  font-size: 20rpx;
  color: white;
}

/* 音频生成中 */
.audio-generating {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.9);
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 9999;
  /* backdrop-filter: blur(20px); 移除不兼容的模糊效果 */
}

.generating-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: white;
}

.loading-animation {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-left: 4rpx solid #007bff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.generating-text {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.generating-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  max-width: 400rpx;
  line-height: 1.4;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .audio-controller {
    padding: 25rpx 15rpx 15rpx;
  }
  
  .main-controls {
    gap: 15rpx;
  }
  
  .progress-info {
    margin: 0 15rpx;
    gap: 10rpx;
  }
  
  .function-controls {
    gap: 10rpx;
  }
  
  .speed-btn,
  .volume-btn {
    width: 60rpx;
    height: 60rpx;
    font-size: 20rpx;
  }
  
  .play-btn {
    width: 80rpx;
    height: 80rpx;
    font-size: 28rpx;
  }
}

/* 音频生成进度样式 */
.generation-progress {
  margin-top: 30rpx;
  width: 100%;
}

.progress-bar-small {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill-small {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #45a049 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
  position: relative;
}

.progress-fill-small::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.6) 50%, transparent 100%);
  animation: shimmer-small 1.5s infinite;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.progress-detail {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  text-align: center;
}

/* 🆕 查看详细进度按钮 */
.view-progress-btn {
  margin-top: 20rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  color: #667eea;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.view-progress-btn::after {
  border: none;
}

.view-progress-btn:active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.2) 0%, rgba(118, 75, 162, 0.2) 100%);
  transform: scale(0.98);
}

@keyframes shimmer-small {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
} 