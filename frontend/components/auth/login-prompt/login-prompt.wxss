/* 登录提示组件样式 */
.login-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 80rpx 40rpx;
}

.prompt-content {
  text-align: center;
  max-width: 500rpx;
}

.prompt-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.prompt-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

.prompt-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
  margin-bottom: 60rpx;
}

.login-btn {
  width: 240rpx;
  height: 80rpx;
  background: #576b95;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  background: #455a8a;
} 