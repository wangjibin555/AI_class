.icon-container {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.icon-image {
  width: 100%;
  height: 100%;
}

.icon-placeholder {
  font-size: inherit;
}

/* 尺寸规格 */
.icon-xs {
  width: 16rpx;
  height: 16rpx;
  font-size: 16rpx;
}

.icon-sm {
  width: 24rpx;
  height: 24rpx;
  font-size: 24rpx;
}

.icon-md {
  width: 32rpx;
  height: 32rpx;
  font-size: 32rpx;
}

.icon-lg {
  width: 48rpx;
  height: 48rpx;
  font-size: 48rpx;
}

.icon-xl {
  width: 64rpx;
  height: 64rpx;
  font-size: 64rpx;
}

.icon-xxl {
  width: 80rpx;
  height: 80rpx;
  font-size: 80rpx;
}

.icon-xxxl {
  width: 120rpx;
  height: 120rpx;
  font-size: 120rpx;
}

/* 悬停效果 */
.icon-container:active {
  opacity: 0.7;
  transform: scale(0.95);
} 