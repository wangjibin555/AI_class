<view class="login-container">
  <!-- 顶部Logo区域 -->
  <view class="logo-section">
    <icon-component name="graduation-cap" size="xxxl" color="#4A90E2" class="logo-icon"></icon-component>
    <text class="app-name">AI课堂</text>
    <text class="app-desc">智能学习，让知识更简单</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-header">
      <text class="welcome-text">欢迎使用</text>
      <text class="login-desc">请使用微信账号登录</text>
    </view>

    <!-- 微信登录按钮 -->
    <button 
      class="wechat-login-btn {{isLoading ? 'loading' : ''}}"
      open-type="getUserInfo"
      bindgetuserinfo="onGetUserInfo"
      disabled="{{isLoading}}"
    >
      <view class="btn-content">
        <view class="btn-icon-wrapper">
          <text class="wechat-icon">💬</text>
        </view>
        <view class="btn-text-wrapper">
          <text class="btn-text">
            {{isLoading ? '登录中...' : '微信快速登录'}}
          </text>
          <text class="btn-subtitle">安全便捷，一键登录</text>
        </view>
        <view class="btn-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </button>

    <!-- 隐私说明 -->
    <view class="privacy-section">
      <text class="privacy-text">
        登录即表示同意
        <text class="privacy-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
        和
        <text class="privacy-link" bindtap="showUserAgreement">《用户协议》</text>
      </text>
    </view>
  </view>

  <!-- 功能介绍 -->
  <view class="features-section">
    <text class="features-title">产品特色</text>
    <view class="feature-list">
      <view class="feature-item">
        <icon-component name="robot" size="lg" color="#4A90E2"></icon-component>
        <text class="feature-text">AI智能生成课件</text>
      </view>
      <view class="feature-item">
        <icon-component name="lightbulb" size="lg" color="#4A90E2"></icon-component>
        <text class="feature-text">语音讲解</text>
      </view>
      <view class="feature-item">
        <icon-component name="pencil" size="lg" color="#4A90E2"></icon-component>
        <text class="feature-text">智能练习</text>
      </view>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view class="loading-mask" wx:if="{{isLoading}}">
    <view class="loading-content">
      <icon-component name="lightbulb" size="xl" color="#4A90E2" class="loading-icon spinning"></icon-component>
      <text class="loading-text">正在登录...</text>
    </view>
  </view>
</view>

<!-- 隐私政策弹窗 -->
<view class="modal" wx:if="{{showPrivacy}}" bindtap="hidePrivacyModal">
  <view class="modal-content" catchtap="preventClose">
    <view class="modal-header">
      <text class="modal-title">隐私政策</text>
      <text class="modal-close" bindtap="hidePrivacyModal">×</text>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <text class="policy-text">
        我们非常重视您的隐私保护。使用AI课堂应用时，我们会收集以下信息：
        
        1. 基本信息：微信昵称、头像等公开信息
        2. 使用数据：学习记录、课件创建记录等
        3. 设备信息：用于优化服务体验
        
        我们承诺：
        - 不会泄露您的个人信息
        - 仅用于提供更好的服务
        - 遵循相关法律法规
      </text>
    </scroll-view>
    <view class="modal-footer">
      <button class="modal-btn" bindtap="hidePrivacyModal">我知道了</button>
    </view>
  </view>
</view> 