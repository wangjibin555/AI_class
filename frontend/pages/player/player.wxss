/* pages/player/player.wxss */
.player-container {
  height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid rgba(255, 255, 255, 0.3);
  border-top: 4px solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.8);
}

/* 主要内容 */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 顶部导航栏 */
.top-nav {
  background: rgba(255, 255, 255, 0.9); /* 增加不透明度替代模糊效果 */
  /* backdrop-filter: blur(15px); 移除不兼容的模糊效果 */
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 1001;
}

.nav-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  min-width: 150rpx;
}

.nav-left {
  justify-content: flex-start;
}

.nav-right {
  justify-content: flex-end;
}

/* 下拉菜单容器 */
.dropdown-container {
  position: relative;
}

/* 菜单按钮 */
.menu-btn {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  padding: 12rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.menu-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.nav-text {
  font-size: 26rpx;
  color: white;
  font-weight: 600;
}

/* 下拉箭头 */
.dropdown-arrow {
  font-size: 20rpx;
  color: white;
  transition: transform 0.3s ease;
  margin-left: 5rpx;
}

.arrow-up {
  transform: rotate(180deg);
}

.arrow-down {
  transform: rotate(0deg);
}

/* 下拉菜单 */
.dropdown-menu {
  position: absolute;
  top: 110%;
  left: 0;
  background: rgba(255, 255, 255, 0.98); /* 增加不透明度替代模糊效果 */
  /* backdrop-filter: blur(20px); 移除不兼容的模糊效果 */
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  min-width: 160rpx;
  z-index: 1002;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.dropdown-menu.show {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  pointer-events: auto;
  animation: dropdownShow 0.3s ease-out;
}

.dropdown-menu.hide {
  opacity: 0;
  transform: translateY(-10rpx);
  visibility: hidden;
  pointer-events: none;
  animation: dropdownHide 0.2s ease-in;
}

@keyframes dropdownShow {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes dropdownHide {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-10rpx);
  }
}

/* 下拉菜单项 */
.dropdown-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: transparent;
  border: none;
  width: 100%;
  text-align: left;
  transition: background-color 0.2s ease;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  cursor: pointer;
  position: relative;
  z-index: 1003;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background: rgba(79, 172, 254, 0.1);
}

.dropdown-icon {
  font-size: 28rpx;
  width: 32rpx;
  text-align: center;
}

.dropdown-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 遮罩层 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
  z-index: 1000;
}

.dropdown-mask.show {
  display: block;
}

.dropdown-mask.hide {
  display: none;
}

/* 进度信息区域 */
.progress-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
}

.slide-counter {
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.progress-bar-mini {
  width: 80rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.progress-fill-mini {
  height: 100%;
  background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
  box-shadow: 0 1rpx 3rpx rgba(79, 172, 254, 0.3);
  position: relative;
}

.progress-fill-mini::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 100%);
  border-radius: 3rpx 3rpx 0 0;
}

/* 次要操作区域 */
.secondary-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .nav-left, .nav-right {
    min-width: 120rpx;
  }
  
  .progress-bar-mini {
    width: 60rpx;
  }
  
  .course-title {
    font-size: 28rpx;
    max-width: 300rpx;
  }
  
  .slide-counter {
    font-size: 24rpx;
  }
  
  .dropdown-menu {
    min-width: 140rpx;
  }
  
  .dropdown-item {
    padding: 14rpx 16rpx;
  }
  
  .dropdown-text {
    font-size: 26rpx;
  }
}

/* 动画效果 */
.nav-btn {
  position: relative;
  overflow: hidden;
}

.nav-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.3s ease, height 0.3s ease;
}

.nav-btn:active::before {
  width: 100rpx;
  height: 100rpx;
}

.nav-center {
  flex: 1;
  text-align: center;
  padding: 0 20rpx;
}

.course-title {
  color: white;
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 400rpx;
  line-height: 1.3;
}

/* 幻灯片容器 */
.slide-container {
  flex: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.slide-content {
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  
  /* 自适应字体支持 */
  --content-font-size: 36rpx;
  --content-line-height: 1.6;
  --title-font-size: 48rpx;
  --slide-padding: 60rpx 40rpx;
  --item-spacing: 16rpx;
}

.slide-title {
  margin-bottom: 40rpx;
  text-align: center;
}

.slide-title text {
  font-size: var(--title-font-size, 48rpx);
  font-weight: 700;
  color: #333;
  line-height: 1.4;
}

.slide-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.content-text {
  font-size: var(--content-font-size, 36rpx);
  line-height: var(--content-line-height, 1.6);
  color: #555;
  white-space: pre-line;
  word-break: break-word;
}

/* 🔥 新增：内容长度自适应样式 */

/* 内容短 - 大字体 */
.slide-content.content-short {
  --content-font-size: 40rpx;
  --content-line-height: 1.6;
  --title-font-size: 64rpx;
}

.slide-content.content-short .content-text {
  font-size: 40rpx;
  line-height: 1.6;
}

.slide-content.content-short .slide-title text {
  font-size: 64rpx;
}

/* 内容中等 - 中等字体 */
.slide-content.content-medium {
  --content-font-size: 36rpx;
  --content-line-height: 1.5;
  --title-font-size: 56rpx;
}

.slide-content.content-medium .content-text {
  font-size: 36rpx;
  line-height: 1.5;
}

.slide-content.content-medium .slide-title text {
  font-size: 56rpx;
}

/* 内容长 - 小字体 */
.slide-content.content-long {
  --content-font-size: 32rpx;
  --content-line-height: 1.4;
  --title-font-size: 48rpx;
}

.slide-content.content-long .content-text {
  font-size: 32rpx;
  line-height: 1.4;
  column-count: 2;
  column-gap: 40rpx;
}

.slide-content.content-long .slide-title text {
  font-size: 48rpx;
}

/* 内容超长 - 最小字体 */
.slide-content.content-extra-long {
  --content-font-size: 28rpx;
  --content-line-height: 1.3;
  --title-font-size: 40rpx;
}

.slide-content.content-extra-long .content-text {
  font-size: 28rpx;
  line-height: 1.3;
  column-count: 2;
  column-gap: 30rpx;
}

.slide-content.content-extra-long .slide-title text {
  font-size: 40rpx;
}

/* 列表样式 */
.content-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.content-list .list-item {
  margin-bottom: var(--item-spacing, 16rpx);
  position: relative;
  padding-left: 40rpx;
  font-size: var(--content-font-size, 36rpx);
  line-height: var(--content-line-height, 1.6);
  color: #555;
}

.content-list .list-item::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #007bff;
  font-weight: bold;
  font-size: var(--content-font-size, 36rpx);
}

/* 重要性标记 */
.importance-badge {
  display: inline-block;
  background: linear-gradient(135deg, #ff6b6b, #ffa500);
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-left: 20rpx;
  font-weight: bold;
}

/* 分类标签 */
.category-tag {
  display: inline-block;
  background: #e3f2fd;
  color: #1976d2;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
  border: 2rpx solid #bbdefb;
}

/* 内容长度指示器 */
.content-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.char-count {
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.font-size {
  background: #e3f2fd;
  color: #1976d2;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.speaker-notes {
  margin-top: 40rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  border-left: 6rpx solid #667eea;
}

.notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.notes-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.notes-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
}

.notes-content {
  font-size: 28rpx;
  line-height: 1.5;
  color: #666;
}

.notes-empty {
  color: #999;
  line-height: 1.6;
  font-size: 28rpx;
  text-align: center;
  padding: 20rpx 0;
  font-style: italic;
}

/* 通用关闭按钮 */
.close-btn {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: #666;
  font-size: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.4);
  transform: scale(0.9);
}

.empty-slide {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
}

.empty-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 32rpx;
}

/* 音频播放器 */
.audio-player {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
}

.audio-controls {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.audio-btn {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: background-color 0.3s;
}

.audio-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.audio-icon {
  font-size: 32rpx;
}

.audio-progress {
  flex: 1;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.3s ease;
}

.time-display {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 播放控制按钮 */
.play-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: none;
  border: none;
  padding: 20rpx;
  border-radius: 15rpx;
  transition: background-color 0.3s;
  min-width: 120rpx;
}

.control-btn:active {
  background: rgba(255, 255, 255, 0.2);
}

.control-btn[disabled] {
  opacity: 0.5;
}

.control-icon {
  font-size: 40rpx;
}

.control-text {
  font-size: 24rpx;
  color: white;
}

.play-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 30rpx;
  border-radius: 50%;
}

/* 学习进度 */
.learning-progress {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

.progress-right {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.progress-percentage {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 幻灯片列表 */
.slide-list {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  /* backdrop-filter: blur(10px); 移除不兼容的模糊效果 */
  z-index: 1001;
  display: flex;
  flex-direction: column;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

.list-title {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
}

.close-btn {
  background: none;
  border: none;
  color: white;
  font-size: 32rpx;
  padding: 10rpx;
}

.list-content {
  flex: 1;
  padding: 20rpx;
}

.slide-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  transition: background-color 0.3s;
}

.slide-item:active {
  background: rgba(255, 255, 255, 0.2);
}

.slide-item.active {
  background: rgba(102, 126, 234, 0.3);
  border: 2rpx solid #667eea;
}

.slide-number {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: white;
  font-weight: 600;
  margin-right: 30rpx;
}

.slide-info {
  flex: 1;
}

.slide-info .slide-title {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.slide-duration {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.slide-status {
  margin-left: 20rpx;
}

.status-icon {
  font-size: 32rpx;
}

/* 音频设置面板 */
.audio-settings-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 背景遮罩 */
.settings-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  /* backdrop-filter: blur(10rpx); 移除不兼容的模糊效果 */
}

/* 设置卡片 */
.settings-card {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 右上角退出按钮 */
.settings-close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.05);
  border: none;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  z-index: 1501;
  transition: all 0.3s ease;
  overflow: hidden;
}

.settings-close-btn:active {
  background: rgba(0, 0, 0, 0.1);
  transform: scale(0.95);
}

.settings-close-btn:hover {
  background: rgba(0, 0, 0, 0.08);
}

/* 退出按钮动画效果 */
.settings-close-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.3s ease, height 0.3s ease;
}

.settings-close-btn:active::before {
  width: 60rpx;
  height: 60rpx;
}

.close-icon {
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
}

.close-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 响应式设计 - 小屏幕优化 */
@media screen and (max-width: 750rpx) {
  .audio-settings-panel {
    padding: 20rpx;
  }
  
  .settings-card {
    max-width: 100%;
  }
  
  .settings-close-btn {
    top: 16rpx;
    right: 16rpx;
    padding: 6rpx 12rpx;
  }
  
  .close-icon {
    font-size: 18rpx;
  }
  
  .close-text {
    font-size: 20rpx;
  }
  
  .settings-header {
    padding: 30rpx 20rpx 20rpx;
  }
  
  .header-icon {
    font-size: 32rpx;
  }
  
  .settings-title {
    font-size: 28rpx;
  }
  
  .setting-section {
    padding: 20rpx;
  }
  
  .speed-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10rpx;
  }
  
  .speed-btn {
    padding: 16rpx 12rpx;
  }
  
  .speed-value {
    font-size: 24rpx;
  }
  
  .action-section {
    padding: 20rpx;
    gap: 12rpx;
  }
  
  .btn-content {
    padding: 20rpx 16rpx;
    gap: 6rpx;
  }
}

.settings-header {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.header-icon {
  font-size: 36rpx;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.settings-content {
  padding: 0;
  background: white;
  overflow-y: auto;
  max-height: 70vh;
}

/* 设置区块 */
.setting-section {
  padding: 30rpx;
  border-bottom: 1px solid #F5F5F7;
}

.setting-section:last-child {
  border-bottom: none;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 24rpx;
  width: 32rpx;
  text-align: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  flex: 1;
}

.section-value {
  font-size: 26rpx;
  color: #4F7EFF;
  font-weight: 600;
}

/* 播放速度网格 */
.speed-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.speed-btn {
  background: #F8F9FA;
  border: 2rpx solid #E9ECEF;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.speed-btn:active {
  transform: scale(0.98);
}

.speed-btn.active {
  background: #4F7EFF;
  border-color: #4F7EFF;
  box-shadow: 0 4rpx 12rpx rgba(79, 126, 255, 0.3);
}

.speed-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #495057;
}

.speed-btn.active .speed-value {
  color: white;
}

/* 音量控制 */
.volume-container {
  padding: 0 10rpx;
}

.volume-slider {
  width: 100%;
}

/* 语音选择器 */
.voice-picker {
  width: 100%;
}

.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border: 2rpx solid #E9ECEF;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.picker-container:active {
  background: #E9ECEF;
  border-color: #DEE2E6;
}

.picker-value {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: #6C757D;
}

/* 开关组 */
.switch-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}

.switch-label {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.custom-switch {
  transform: scale(0.9);
}

/* 操作按钮区域 */
.action-section {
  display: flex;
  gap: 16rpx;
  padding: 30rpx;
  background: #F8F9FA;
}

.action-btn {
  flex: 1;
  border: none;
  border-radius: 16rpx;
  padding: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.btn-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 20rpx;
}

.reset-btn {
  background: #FFF5F5;
  border: 2rpx solid #FED7D7;
}

.reset-btn:active {
  background: #FED7D7;
}

.reset-btn .btn-icon {
  font-size: 32rpx;
}

.reset-btn .btn-text {
  font-size: 26rpx;
  color: #E53E3E;
  font-weight: 600;
}

.preview-btn {
  background: #F0FFF4;
  border: 2rpx solid #C6F6D5;
}

.preview-btn:active {
  background: #C6F6D5;
}

.preview-btn .btn-icon {
  font-size: 32rpx;
}

.preview-btn .btn-text {
  font-size: 26rpx;
  color: #38A169;
  font-weight: 600;
}

.setting-item {
  margin-bottom: 40rpx;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

/* 播放速度控制 */
.speed-controls {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.speed-btn {
  padding: 15rpx 25rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 25rpx;
  background: white;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.speed-btn.active {
  background: #667eea;
  border-color: #667eea;
  color: white;
}

.speed-btn:not(.active):active {
  background: #f0f0f0;
}

/* 音量滑块 */
.volume-slider {
  width: 100%;
  margin: 20rpx 0;
}

/* 语音选择器 */
.voice-picker {
  width: 100%;
}

.picker-display {
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  background: white;
  font-size: 26rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 自动播放开关 */
.auto-play-switch {
  transform: scale(1.2);
}

/* 设置操作按钮 */
.settings-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  justify-content: center;
}

.settings-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 15rpx;
  border: none;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.reset-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
}

.preview-btn {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  color: white;
}

.settings-btn:active {
  transform: scale(0.95);
}

.btn-icon {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 24rpx;
  font-weight: 500;
}

