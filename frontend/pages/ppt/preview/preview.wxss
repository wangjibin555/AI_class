/* pages/ppt/preview/preview.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  overflow: hidden;
}

/* 自定义状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.status-left, .status-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-center {
  flex: 1;
  text-align: center;
  margin: 0 20rpx;
}

.status-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(103, 126, 234, 0.1);
  border: none;
  font-size: 32rpx;
  color: #667eea;
  transition: all 0.3s ease;
}

.status-btn:active {
  background: rgba(103, 126, 234, 0.2);
  transform: scale(0.95);
}

.status-icon {
  font-size: 28rpx;
  font-weight: bold;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 4rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
}

.loading-spinner {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.spinner-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 6rpx solid transparent;
  border-top: 6rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1.5s linear infinite;
}

.spinner-ring:nth-child(2) {
  animation-delay: -0.5s;
  border-top-color: #764ba2;
}

.spinner-ring:nth-child(3) {
  animation-delay: -1s;
  border-top-color: #f093fb;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.loading-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
}

.error-icon-wrapper {
  position: relative;
  margin-bottom: 40rpx;
}

.error-icon {
  font-size: 120rpx;
  opacity: 0.6;
}

.error-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff6b6b;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.error-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.error-description {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 60rpx;
  max-width: 500rpx;
}

.error-actions {
  display: flex;
  gap: 20rpx;
}

.error-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
  min-width: 160rpx;
  justify-content: center;
  transition: all 0.3s ease;
}

.error-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 25rpx rgba(103, 126, 234, 0.3);
}

.error-btn.secondary {
  background: rgba(0, 0, 0, 0.05);
  color: #333;
}

.error-btn:active {
  transform: translateY(2rpx);
}

.btn-icon {
  font-size: 24rpx;
}

.btn-text {
  font-weight: 500;
}

/* PPT内容区域 */
.ppt-container {
  flex: 1;
  position: relative;
  background: white;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  box-shadow: 0 -8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.ppt-webview {
  width: 100%;
  height: 100%;
  border-radius: 20rpx 20rpx 0 0;
}

.ppt-webview.fullscreen {
  border-radius: 0;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* 浮动导航控制 */
.floating-controls {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 30rpx;
  border-radius: 60rpx;
  z-index: 100;
}

.float-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: white;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.float-btn:not([disabled]):active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.float-btn[disabled] {
  opacity: 0.3;
}

.float-icon {
  font-weight: bold;
}

.slide-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 20rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

.slide-separator {
  opacity: 0.6;
}

/* 底部工具栏 */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  min-width: 100rpx;
}

.tool-btn:active {
  background: rgba(103, 126, 234, 0.1);
  transform: scale(0.95);
}

.tool-icon {
  font-size: 32rpx;
}

.tool-label {
  font-size: 20rpx;
  color: #666;
  font-weight: 500;
}

/* 操作弹窗样式 */
.action-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.action-sheet.show {
  opacity: 1;
  visibility: visible;
}

.action-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10rpx);
}

.action-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx 30rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.action-sheet.show .action-content {
  transform: translateY(0);
}

.action-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.action-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.action-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  border: none;
  font-size: 24rpx;
  color: #666;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  background: none;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  transition: background 0.3s ease;
  text-align: left;
}

.action-item:active {
  background: rgba(0, 0, 0, 0.05);
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-weight: 500;
}

/* 分享弹窗样式 */
.share-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.share-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10rpx);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 40rpx;
  max-width: 600rpx;
  width: 100%;
  transform: scale(0.8);
  transition: transform 0.3s ease;
}

.share-modal.show .modal-content {
  transform: scale(1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  border: none;
  font-size: 24rpx;
  color: #666;
}

.share-options {
  display: flex;
  gap: 30rpx;
  justify-content: center;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 20rpx;
  background: none;
  border: none;
  border-radius: 20rpx;
  transition: background 0.3s ease;
  min-width: 120rpx;
}

.share-option:active {
  background: rgba(0, 0, 0, 0.05);
}

.share-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: white;
}

.share-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
} 