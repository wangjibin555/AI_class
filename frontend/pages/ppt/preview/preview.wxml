<!--pages/ppt/preview/preview.wxml-->
<view class="container">
  <!-- 自定义状态栏 -->
  <view class="status-bar" wx:if="{{!isLoading && !loadError}}">
    <view class="status-left">
      <button class="status-btn back-btn" bindtap="goBack">
        <text class="status-icon">←</text>
      </button>
    </view>
    
    <view class="status-center">
      <text class="status-title">{{title}}</text>
      <text class="status-subtitle" wx:if="{{currentSlide && totalSlides}}">
        {{currentSlide}} / {{totalSlides}}
      </text>
    </view>
    
    <view class="status-right">
      <button class="status-btn fullscreen-btn" bindtap="toggleFullScreen">
        <text class="status-icon">⛶</text>
      </button>
      <button class="status-btn more-btn" bindtap="showMoreActions">
        <text class="status-icon">⋯</text>
      </button>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading && !loadError}}">
    <view class="loading-spinner">
      <view class="spinner-ring"></view>
      <view class="spinner-ring"></view>
      <view class="spinner-ring"></view>
    </view>
    <text class="loading-text">正在加载PPT演示...</text>
    <text class="loading-subtitle">请稍候片刻</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{loadError}}">
    <view class="error-icon-wrapper">
      <text class="error-icon">📊</text>
      <text class="error-badge">!</text>
    </view>
    <text class="error-title">无法加载PPT</text>
    <text class="error-description">
      网络连接异常或文件已失效，请检查网络连接后重试
    </text>
    <view class="error-actions">
      <button class="error-btn primary" bindtap="reloadPPT">
        <text class="btn-icon">🔄</text>
        <text class="btn-text">重新加载</text>
      </button>
      <button class="error-btn secondary" bindtap="goBack">
        <text class="btn-icon">←</text>
        <text class="btn-text">返回</text>
      </button>
    </view>
  </view>

  <!-- PPT内容区域 -->
  <view class="ppt-container" wx:if="{{!isLoading && !loadError}}">
    <!-- Web-view显示PPT -->
    <web-view 
      wx:if="{{pptURL}}"
      src="{{pptURL}}"
      bindload="onWebViewLoad"
      binderror="onWebViewError"
      bindmessage="onWebViewMessage"
      class="ppt-webview {{isFullScreen ? 'fullscreen' : ''}}"
      webview-styles="background: #f5f5f5;"
    ></web-view>

    <!-- 浮动导航控制 -->
    <view class="floating-controls" wx:if="{{!isFullScreen}}">
      <button class="float-btn prev-btn" bindtap="previousSlide" disabled="{{currentSlide <= 1}}">
        <text class="float-icon">⟨</text>
      </button>
      
      <view class="slide-indicator">
        <text class="slide-current">{{currentSlide || 1}}</text>
        <text class="slide-separator">/</text>
        <text class="slide-total">{{totalSlides || '?'}}</text>
      </view>
      
      <button class="float-btn next-btn" bindtap="nextSlide" disabled="{{currentSlide >= totalSlides}}">
        <text class="float-icon">⟩</text>
      </button>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar" wx:if="{{!isLoading && !loadError && !isFullScreen}}">
    <button class="tool-btn" bindtap="zoomOut">
      <text class="tool-icon">🔍−</text>
      <text class="tool-label">缩小</text>
    </button>
    
    <button class="tool-btn" bindtap="zoomIn">
      <text class="tool-icon">🔍+</text>
      <text class="tool-label">放大</text>
    </button>
    
    <button class="tool-btn" bindtap="resetZoom">
      <text class="tool-icon">⌂</text>
      <text class="tool-label">适应</text>
    </button>
    
    <button class="tool-btn" bindtap="sharePPT">
      <text class="tool-icon">📤</text>
      <text class="tool-label">分享</text>
    </button>
    
    <button class="tool-btn" bindtap="downloadPPT">
      <text class="tool-icon">💾</text>
      <text class="tool-label">下载</text>
    </button>
  </view>

  <!-- 更多操作弹窗 -->
  <view class="action-sheet {{showActionSheet ? 'show' : ''}}" wx:if="{{showActionSheet}}">
    <view class="action-mask" bindtap="hideMoreActions"></view>
    <view class="action-content">
      <view class="action-header">
        <text class="action-title">更多操作</text>
        <button class="action-close" bindtap="hideMoreActions">✕</button>
      </view>
      
      <view class="action-list">
        <button class="action-item" bindtap="toggleFullScreen">
          <text class="action-icon">{{isFullScreen ? '🗗' : '⛶'}}</text>
          <text class="action-text">{{isFullScreen ? '退出全屏' : '全屏查看'}}</text>
        </button>
        
        <button class="action-item" bindtap="sharePPT">
          <text class="action-icon">📤</text>
          <text class="action-text">分享PPT</text>
        </button>
        
        <button class="action-item" bindtap="downloadPPT">
          <text class="action-icon">💾</text>
          <text class="action-text">下载到本地</text>
        </button>
        
        <button class="action-item" bindtap="copyLink">
          <text class="action-icon">🔗</text>
          <text class="action-text">复制链接</text>
        </button>
        
        <button class="action-item" bindtap="reportIssue">
          <text class="action-icon">⚠️</text>
          <text class="action-text">报告问题</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 分享弹窗 -->
  <view class="share-modal {{showShareModal ? 'show' : ''}}" wx:if="{{showShareModal}}">
    <view class="modal-mask" bindtap="hideShareModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">分享PPT</text>
        <button class="modal-close" bindtap="hideShareModal">✕</button>
      </view>
      
      <view class="share-options">
        <button class="share-option" open-type="share">
          <view class="share-icon">💬</view>
          <text class="share-text">分享给朋友</text>
        </button>
        
        <button class="share-option" bindtap="copyLink">
          <view class="share-icon">🔗</view>
          <text class="share-text">复制链接</text>
        </button>
        
        <button class="share-option" bindtap="generateQRCode">
          <view class="share-icon">📱</view>
          <text class="share-text">生成二维码</text>
        </button>
      </view>
    </view>
  </view>
</view> 