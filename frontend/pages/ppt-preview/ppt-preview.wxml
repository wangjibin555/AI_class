<!--pages/ppt-preview/ppt-preview.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{loadingMessage}}</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{hasError}}" class="error-container">
    <view class="error-icon">⚠️</view>
    <text class="error-message">{{errorMessage}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <!-- PPT预览 -->
  <view wx:else class="preview-container"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd"
        bindtap="onDoubleTap"
        bindlongpress="onLongPress">
    <!-- 全屏Web-view -->
    <web-view 
      wx:if="{{htmlPreviewUrl}}"
      src="{{htmlPreviewUrl}}"
      bindmessage="onWebViewMessage"
      bindload="onWebViewLoad"
      binderror="onWebViewError"
      class="fullscreen-webview">
    </web-view>
    
    <!-- 自定义控制栏 -->
    <view class="control-bar {{controlBarVisible ? 'visible' : 'hidden'}}" bindtap="onControlBarTap">
      <!-- 返回按钮 -->
      <view class="control-item back-btn" bindtap="onBack">
        <text class="icon">←</text>
        <text class="label">返回</text>
      </view>
      
      <!-- 标题 -->
      <view class="control-item title-area">
        <text class="title">{{pptTitle}}</text>
        <text class="subtitle">{{slideInfo}}</text>
      </view>
      
      <!-- 功能按钮 -->
      <view class="control-item actions">
        <view class="action-btn" bindtap="onToggleFullscreen">
          <text class="icon">⛶</text>
        </view>
        <view class="action-btn" bindtap="onShare">
          <text class="icon">📤</text>
        </view>
        <view class="action-btn {{hasDownload ? 'enabled' : 'disabled'}} {{downloading ? 'loading' : ''}}" 
              bindtap="onDownload">
          <text class="icon" wx:if="{{!downloading}}">{{hasDownload ? '📥' : '⚠️'}}</text>
          <text class="icon loading-icon" wx:else>⏳</text>
        </view>
      </view>
    </view>
    
    <!-- 左侧功能按钮组 -->
    <view class="side-controls {{controlBarVisible ? 'visible' : 'hidden'}}"
          data-debug="side-controls">
      <!-- 预览/导航按钮 -->
      <view class="side-btn" 
            bindtap="onPreview" 
            catchtap="onPreview"
            data-button="preview"
            title="预览模式">
        <text class="side-icon">👁️</text>
      </view>
      
      <!-- 复制链接按钮 -->
      <view class="side-btn" 
            bindtap="onCopyLink" 
            catchtap="onCopyLink"
            data-button="copy"
            title="复制链接">
        <text class="side-icon">🔗</text>
      </view>
      
      <!-- 放大镜/搜索按钮 -->
      <view class="side-btn" 
            bindtap="onZoomToggle" 
            catchtap="onZoomToggle"
            data-button="zoom"
            title="缩放">
        <text class="side-icon">🔍</text>
      </view>
      
      <!-- 下载按钮 - 高亮显示 -->
      <view class="side-btn download-btn {{hasDownload ? 'enabled' : 'disabled'}} {{downloading ? 'loading' : ''}}" 
            bindtap="onDownload" 
            catchtap="onDownload"
            data-button="download"
            title="下载PPT">
        <text class="side-icon" wx:if="{{!downloading}}">{{hasDownload ? '📥' : '⚠️'}}</text>
        <text class="side-icon loading-spin" wx:else>⏳</text>
      </view>
    </view>
    
    <!-- 手势检测覆盖层 -->
    <view 
      class="touch-overlay" 
      bindtap="onToggleControls"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
      bindlongpress="onLongPress"
      catchtap="onTouchOverlayTap"
    ></view>
  </view>
</view>