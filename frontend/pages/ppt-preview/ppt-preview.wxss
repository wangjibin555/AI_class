/* pages/ppt-preview/ppt-preview.wxss */

/* 字体栈定义 */
page {
  font-family: "League Spartan", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 50%, #90caf9 100%);
  position: relative;
  overflow: hidden;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #1976d2;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(25, 118, 210, 0.2);
  border-top: 4rpx solid #1976d2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(25, 118, 210, 0.3);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #1976d2;
  text-align: center;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
}

.error-icon {
  font-size: 96rpx;
  margin-bottom: 40rpx;
  color: #f44336;
  text-shadow: 0 2rpx 8rpx rgba(244, 67, 54, 0.3);
}

.error-message {
  font-size: 32rpx;
  font-weight: 400;
  color: #424242;
  margin-bottom: 60rpx;
  line-height: 1.6;
  max-width: 600rpx;
  letter-spacing: 0.5rpx;
}

.retry-btn {
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 20rpx rgba(25, 118, 210, 0.3);
  transition: all 0.3s ease;
}

.retry-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(25, 118, 210, 0.4);
}

/* PPT预览容器 */
.preview-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

/* 全屏Web-view */
.fullscreen-webview {
  width: 100%;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 控制栏 */
.control-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 70%, transparent 100%);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  z-index: 1000;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-bottom: 1rpx solid rgba(25, 118, 210, 0.1);
}

.control-bar.hidden {
  transform: translateY(-100%);
}

.control-bar.visible {
  transform: translateY(0);
}

/* 控制栏项目 */
.control-item {
  display: flex;
  align-items: center;
}

/* 返回按钮 */
.back-btn {
  flex-direction: column;
  margin-right: 40rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  min-width: 100rpx;
  background: rgba(25, 118, 210, 0.1);
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(25, 118, 210, 0.2);
  transform: scale(0.95);
}

.back-btn .icon {
  font-size: 32rpx;
  color: #1976d2;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.back-btn .label {
  font-size: 24rpx;
  color: #1976d2;
  font-weight: 500;
}

/* 标题区域 */
.title-area {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 30rpx;
}

.title {
  font-size: 38rpx;
  color: #1976d2;
  font-weight: 700;
  margin-bottom: 8rpx;
  max-width: 500rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 32rpx;
  color: #424242;
  font-weight: 400;
}

/* 操作按钮区域 */
.actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(25, 118, 210, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20px);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid rgba(25, 118, 210, 0.2);
}

.action-btn:active {
  transform: scale(0.9);
  background: rgba(25, 118, 210, 0.2);
  border-color: rgba(25, 118, 210, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(25, 118, 210, 0.3);
}

.action-btn .icon {
  font-size: 32rpx;
  color: #1976d2;
}

/* 移动端适配 */
@media screen and (max-width: 768px) {
  .side-controls {
    left: 30rpx;
    bottom: 100rpx;
    gap: 20rpx;
  }
  
  .side-btn {
    width: 80rpx;
    height: 80rpx;
  }
  
  .side-icon {
    font-size: 36rpx;
  }
}

/* 触摸覆盖层 */
.touch-overlay {
  position: fixed;
  top: 140rpx;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500; /* 降低z-index，让按钮在上方 */
  background: transparent;
  pointer-events: auto; /* 确保可以接收手势事件 */
}

/* 响应式设计 */
@media screen and (orientation: landscape) {
  .control-bar {
    height: 120rpx;
    padding: 0 60rpx;
  }
  
  .back-btn .icon {
    font-size: 28rpx;
  }
  
  .title {
    font-size: 34rpx;
  }
  
  .subtitle {
    font-size: 26rpx;
  }
  
  .action-btn {
    width: 76rpx;
    height: 76rpx;
  }
  
  .action-btn .icon {
    font-size: 28rpx;
  }
}

/* 小屏幕适配 */
@media screen and (max-width: 375px) {
  .title {
    font-size: 34rpx;
    max-width: 400rpx;
  }
  
  .subtitle {
    font-size: 26rpx;
  }
  
  .actions {
    gap: 20rpx;
  }
  
  .action-btn {
    width: 76rpx;
    height: 76rpx;
  }
}

/* 动画效果 */
.control-bar {
  animation: slideInDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideInDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 加载动画增强 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

.loading-spinner {
  animation: spin 1s linear infinite, pulse 2s ease-in-out infinite;
}

/* 按钮悬浮动画 */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-2rpx);
  }
}

.action-btn {
  animation: float 3s ease-in-out infinite;
}

.action-btn:nth-child(1) {
  animation-delay: 0s;
}

.action-btn:nth-child(2) {
  animation-delay: 0.5s;
}

.action-btn:nth-child(3) {
  animation-delay: 1s;
}

/* 深色主题适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background: linear-gradient(135deg, #1a237e 0%, #283593 50%, #3949ab 100%);
  }
  
  .control-bar {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.7) 70%, transparent 100%);
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .loading-container, .error-container {
    background: rgba(0, 0, 0, 0.9);
  }
  
  .loading-text, .error-message {
    color: rgba(255, 255, 255, 0.9);
  }
  
  .title {
    color: #fff;
  }
  
  .subtitle {
    color: rgba(255, 255, 255, 0.7);
  }
  
  .back-btn .icon, .back-btn .label {
    color: #fff;
  }
  
  .action-btn .icon {
    color: #fff;
  }
}

/* 侧边功能按钮组样式 */
.side-controls {
  position: absolute;
  left: 40rpx;
  bottom: 120rpx;
  z-index: 1000; /* 提高z-index，确保在touch-overlay之上 */
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: auto; /* 确保按钮可以接收点击事件 */
}

.side-controls.visible {
  opacity: 1;
  transform: translateX(0);
}

.side-controls.hidden {
  opacity: 0;
  transform: translateX(-120rpx);
}

.side-btn {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(145deg, #4285f4 0%, #1976d2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8rpx 32rpx rgba(25, 118, 210, 0.4),
    0 2rpx 8rpx rgba(25, 118, 210, 0.2);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
}

.side-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
  border-radius: 50%;
  transition: opacity 0.3s ease;
  opacity: 0;
}

.side-btn:active {
  transform: scale(0.95);
  box-shadow: 
    0 4rpx 20rpx rgba(25, 118, 210, 0.3),
    0 1rpx 4rpx rgba(25, 118, 210, 0.2);
}

.side-btn:active::before {
  opacity: 1;
}

.side-icon {
  font-size: 42rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

/* 下载按钮特殊样式 */
.side-btn.download-btn.enabled {
  background: linear-gradient(145deg, #ff6b35 0%, #f7941d 100%);
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 
    0 8rpx 32rpx rgba(255, 107, 53, 0.4),
    0 2rpx 8rpx rgba(255, 107, 53, 0.2);
}

.side-btn.download-btn.disabled {
  background: linear-gradient(145deg, #9e9e9e 0%, #757575 100%);
  box-shadow: 
    0 4rpx 16rpx rgba(117, 117, 117, 0.3),
    0 1rpx 4rpx rgba(117, 117, 117, 0.2);
}

.side-btn.download-btn.loading {
  background: linear-gradient(145deg, #ffa726 0%, #ff9800 100%);
}

.side-icon.loading-spin {
  animation: spin 1.5s linear infinite;
}

/* 按钮进入动画 */
.side-btn {
  animation: slideInLeft 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.side-btn:nth-child(1) { animation-delay: 0.1s; }
.side-btn:nth-child(2) { animation-delay: 0.2s; }
.side-btn:nth-child(3) { animation-delay: 0.3s; }
.side-btn:nth-child(4) { animation-delay: 0.4s; }

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-100rpx) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

/* 控制栏按钮状态样式 */
.action-btn.enabled {
  opacity: 1;
}

.action-btn.disabled {
  opacity: 0.5;
}

.action-btn.loading .loading-icon {
  animation: spin 1s linear infinite;
}