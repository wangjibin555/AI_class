/* pages/ai-assistant/ai-assistant.wxss */
/* DeepSeek 风格的 AI 助手界面 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
}



/* 消息容器 */
.messages-container {
  flex: 1;
  padding: 0;
  overflow-y: auto;
  background: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  height: 100%;
  min-height: 500rpx;
  padding: 40rpx 30rpx;
}

.welcome-message {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  width: 100%;
}

.ai-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 28rpx;
}

.welcome-bubble {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
  padding: 24rpx;
  max-width: 80%;
  flex: 1;
}

.welcome-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* 消息列表 */
.messages-list {
  padding: 40rpx 30rpx;
}

.message-item {
  margin-bottom: 40rpx;
}

/* 用户消息 */
.user-message {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 40rpx;
}

.user-bubble {
  background: #3b82f6;
  color: white;
  border-radius: 16rpx;
  border-top-right-radius: 4rpx;
  padding: 20rpx 24rpx;
  max-width: 80%;
  word-wrap: break-word;
}

/* AI消息 */
.ai-message {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.ai-content {
  flex: 1;
  max-width: calc(100% - 80rpx);
}

.ai-bubble {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
  padding: 24rpx;
  word-wrap: break-word;
}

.ai-bubble.loading {
  padding: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #111827;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.user-bubble .message-text {
  color: white;
}

/* 代码块样式 */
.code-block {
  margin-top: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1f2937;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #374151;
  border-bottom: 1rpx solid #4b5563;
}

.code-lang {
  font-size: 24rpx;
  color: #d1d5db;
  font-weight: 500;
}

.copy-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #4b5563;
  border: none;
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
  color: #d1d5db;
  font-size: 22rpx;
}

.copy-btn::after {
  border: none;
}

.copy-icon {
  font-size: 20rpx;
}

.copy-text {
  font-size: 22rpx;
}

.code-content {
  padding: 20rpx;
  background: #1f2937;
}

.code-text {
  font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
  font-size: 24rpx;
  line-height: 1.5;
  color: #e5e7eb;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* 消息操作按钮 */
.message-actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 2rpx;
  margin-top: 8rpx;
  padding-left: 0;
}

.action-btn {
  background: transparent;
  border: none;
  padding: 4rpx 6rpx;
  border-radius: 6rpx;
  color: #9ca3af;
  font-size: 18rpx;
  line-height: 1;
  transition: all 0.2s ease;
  min-width: 48rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  background: rgba(156, 163, 175, 0.1);
  color: #6b7280;
  transform: scale(0.96);
}

.action-icon {
  font-size: 24rpx;
  opacity: 0.7;
}



/* 加载状态 */
.loading-message {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9ca3af;
  animation: typing 1.4s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 底部新对话按钮 */
.bottom-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
}

.new-chat-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f3f4f6;
  border: none;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  color: #374151;
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.new-chat-btn::after {
  border: none;
}

.new-chat-btn:hover {
  background: #e5e7eb;
}

.new-chat-icon {
  font-size: 24rpx;
  font-weight: 600;
}

.new-chat-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 输入区域 */
.input-container {
  padding: 20rpx 30rpx 40rpx 30rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.input-wrapper:focus-within {
  border-color: #3b82f6;
  background: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.1);
}

.message-input {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
  border: none;
  outline: none;
  color: #111827;
}

.message-input::placeholder {
  color: #9ca3af;
}

.send-btn {
  width: 56rpx;
  height: 56rpx;
  background: #e5e7eb;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  color: #6b7280;
}

.send-btn.active {
  background: #3b82f6;
  color: white;
  transform: scale(1.05);
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background: #e5e7eb;
  color: #9ca3af;
  opacity: 0.6;
}

.send-icon {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

.loading-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #d1d5db;
  border-top: 2rpx solid #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 动画效果 */
@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-6rpx);
    opacity: 1;
  }
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .navbar {
    padding: 8rpx 16rpx;
  }
  
  .messages-list {
    padding: 30rpx 20rpx;
  }
  
  .empty-state {
    padding: 30rpx 20rpx;
  }
  
  .input-container {
    padding: 16rpx 20rpx 30rpx 20rpx;
  }
  
  .user-bubble,
  .ai-bubble {
    max-width: 85%;
  }
}