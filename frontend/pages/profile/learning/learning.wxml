<!--pages/profile/learning/learning.wxml-->
<view class="container">
  <!-- 统计信息 -->
  <view class="stats-section">
    <view class="stats-title">学习统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{stats.totalCourses}}</text>
        <text class="stat-label">总课程</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.completedCourses}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.inProgressCourses}}</text>
        <text class="stat-label">学习中</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{formatStudyTime(stats.totalStudyTime)}}</text>
        <text class="stat-label">总时长</text>
      </view>
    </view>
  </view>

  <!-- 筛选器 -->
  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-item">
        <text class="filter-label">状态</text>
        <picker 
          mode="selector"
          range="{{statusOptions}}"
          range-key="label"
          value="{{statusIndex}}"
          bindchange="onStatusFilterChange"
        >
          <view class="picker-display">
            <text>{{currentStatusLabel}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      
      <view class="filter-item">
        <text class="filter-label">分类</text>
        <picker 
          mode="selector"
          range="{{categoryOptions}}"
          range-key="label"
          value="{{categoryIndex}}"
          bindchange="onCategoryFilterChange"
        >
          <view class="picker-display">
            <text>{{currentCategoryLabel}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 学习记录列表 -->
  <view class="records-section">
    <view class="section-title">
      <text>学习记录</text>
      <text class="record-count">({{learningRecords.length}})</text>
    </view>
    
    <view class="records-list" wx:if="{{learningRecords.length > 0}}">
      <view 
        class="record-item"
        wx:for="{{learningRecords}}"
        wx:key="id"
      >
        <!-- 课程信息 -->
        <view class="course-info" bindtap="viewCourseDetail" data-id="{{item.course_id}}">
          <view class="course-header">
            <text class="course-title">{{item.course_title}}</text>
            <view class="course-status status-{{item.status}}">
              <text wx:if="{{item.status === 'in_progress'}}">学习中</text>
              <text wx:elif="{{item.status === 'completed'}}">已完成</text>
              <text wx:elif="{{item.status === 'expired'}}">已过期</text>
            </view>
          </view>
          
          <view class="course-meta">
            <text class="course-category">{{item.course_category}}</text>
            <text class="course-progress">进度: {{item.progress}}%</text>
          </view>
          
          <view class="course-stats">
            <text class="stat">学习时长: {{formatStudyTime(item.study_duration)}}</text>
            <text class="stat">最后学习: {{formatDate(item.last_study_time)}}</text>
          </view>
        </view>
        
        <!-- 操作按钮 -->
        <view class="record-actions">
          <!-- 第一行：继续学习/重新开始 + 删除 -->
          <view class="action-row-primary">
            <button 
              class="action-btn primary"
              wx:if="{{item.status === 'in_progress'}}"
              bindtap="continueLearning"
              data-id="{{item.course_id}}"
            >
              继续学习
            </button>
            
            <button 
              class="action-btn secondary"
              wx:if="{{item.status === 'completed' || item.status === 'expired'}}"
              bindtap="restartLearning"
              data-id="{{item.course_id}}"
            >
              重新开始
            </button>
            
            <button 
              class="action-btn danger"
              bindtap="deleteRecord"
              data-id="{{item.id}}"
            >
              删除
            </button>
          </view>
          

        </view>
        
        <!-- 学习详情 -->
        <view class="learning-details" wx:if="{{item.quiz_attempts > 0}}">
          <view class="detail-item">
            <text class="detail-label">测验次数:</text>
            <text class="detail-value">{{item.quiz_attempts}}次</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">最高分数:</text>
            <text class="detail-value">{{item.highest_score}}分</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">平均分数:</text>
            <text class="detail-value">{{item.average_score}}分</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{learningRecords.length === 0 && !loading}}">
      <text class="empty-icon">📚</text>
      <text class="empty-title">暂无学习记录</text>
      <text class="empty-desc">开始学习课程，记录将在这里显示</text>
      <button class="empty-btn" bindtap="goToCourseList">去学习</button>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && learningRecords.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:else>上拉加载更多</text>
    </view>
    
    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && learningRecords.length > 0}}">
      <text>没有更多记录了</text>
    </view>
  </view>
</view>