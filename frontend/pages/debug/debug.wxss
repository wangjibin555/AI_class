.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-refresh {
  background-color: #4A90E2;
  color: white;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
}

.section {
  background-color: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 10rpx;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
  align-items: flex-start;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
  flex: 1;
}

.no-data {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.actions button {
  flex: 1;
  min-width: 200rpx;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.btn-test {
  background-color: #28a745;
  color: white;
}

.btn-copy {
  background-color: #ffc107;
  color: #333;
}

.btn-clear {
  background-color: #dc3545;
  color: white;
}

.logs {
  max-height: 400rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
}

.log-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 10rpx;
  font-family: monospace;
}