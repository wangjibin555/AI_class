<!--调试页面-->
<view class="container">
  <view class="header">
    <text class="title">配置调试页面</text>
    <button class="btn-refresh" bind:tap="refreshInfo">刷新</button>
  </view>

  <!-- 环境信息 -->
  <view class="section">
    <view class="section-title">环境信息</view>
    <view class="info-item">
      <text class="label">环境:</text>
      <text class="value">{{envInfo.environment}}</text>
    </view>
  </view>

  <!-- 默认配置 -->
  <view class="section">
    <view class="section-title">默认配置</view>
    <view class="info-item">
      <text class="label">BaseURL:</text>
      <text class="value">{{envInfo.defaultConfig.baseURL}}</text>
    </view>
    <view class="info-item">
      <text class="label">WebSocket:</text>
      <text class="value">{{envInfo.defaultConfig.wsURL}}</text>
    </view>
    <view class="info-item">
      <text class="label">文件服务:</text>
      <text class="value">{{envInfo.defaultConfig.fileURL}}</text>
    </view>
  </view>

  <!-- 动态配置 -->
  <view class="section">
    <view class="section-title">服务器动态配置</view>
    <view wx:if="{{envInfo.dynamicConfig}}">
      <view class="info-item">
        <text class="label">BaseURL:</text>
        <text class="value">{{envInfo.dynamicConfig.base_url}}</text>
      </view>
      <view class="info-item">
        <text class="label">WebSocket:</text>
        <text class="value">{{envInfo.dynamicConfig.ws_url}}</text>
      </view>
      <view class="info-item">
        <text class="label">文件服务:</text>
        <text class="value">{{envInfo.dynamicConfig.file_url}}</text>
      </view>
    </view>
    <view wx:else class="no-data">
      <text>未获取到服务器配置</text>
    </view>
  </view>

  <!-- 当前使用的配置 -->
  <view class="section">
    <view class="section-title">当前使用配置</view>
    <view class="info-item">
      <text class="label">BaseURL:</text>
      <text class="value">{{currentConfig.baseURL}}</text>
    </view>
    <view class="info-item">
      <text class="label">WebSocket:</text>
      <text class="value">{{currentConfig.wsURL}}</text>
    </view>
    <view class="info-item">
      <text class="label">文件服务:</text>
      <text class="value">{{currentConfig.fileURL}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-test" bind:tap="testConfigAPI">测试配置API</button>
    <button class="btn-copy" bind:tap="copyInfo">复制信息</button>
    <button class="btn-clear" bind:tap="clearLogs">清空日志</button>
  </view>

  <!-- 日志 -->
  <view class="section">
    <view class="section-title">操作日志</view>
    <scroll-view class="logs" scroll-y>
      <view wx:for="{{logs}}" wx:key="index" class="log-item">
        {{item}}
      </view>
    </scroll-view>
  </view>
</view>