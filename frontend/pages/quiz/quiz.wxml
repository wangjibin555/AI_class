<!--pages/quiz/quiz.wxml-->
<view class="quiz-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载练习中...</text>
  </view>

  <!-- 练习信息 -->
  <view wx:elif="{{!isStarted}}" class="quiz-info">
    <view class="quiz-header">
      <view class="course-title">{{courseInfo.title}}</view>
      <view class="quiz-title">练习测试</view>
    </view>
    
    <view class="quiz-details">
      <view class="detail-item">
        <text class="label">题目数量：</text>
        <text class="value">{{userSelectedQuestionCount || totalQuestions}} 题</text>
      </view>
      <view class="detail-item">
        <text class="label">时间限制：</text>
        <text class="value">{{timeLimit}} 分钟</text>
      </view>
      <view class="detail-item">
        <text class="label">难度等级：</text>
        <text class="value">{{difficultyDisplay}}</text>
      </view>
    </view>
    
    <view class="quiz-description">
      <text>{{quiz.description || '基于课程内容生成的练习，测试你的学习成果。'}}</text>
    </view>
    
    <view class="start-button-container">
      <button class="start-button" bindtap="startQuiz" loading="{{submitting}}">
        开始练习
      </button>
    </view>
  </view>

  <!-- 答题界面 -->
  <view wx:elif="{{!isCompleted}}" class="quiz-interface">
    <!-- 顶部信息栏 -->
    <view class="quiz-header-bar">
      <view class="progress-info">
        <text class="progress-text">{{formatProgress()}}</text>
      </view>
      <view class="time-info">
        <text class="time-text">{{formatTime(timeRemaining)}}</text>
      </view>
    </view>

    <!-- 题目内容 -->
    <view class="question-container">
      <view class="question-header">
        <text class="question-number">第 {{currentQuestionIndex + 1}} 题</text>
        <text class="question-type">{{currentQuestion.type === 'single_choice' ? '单选题' : currentQuestion.type === 'multiple_choice' ? '多选题' : '填空题'}}</text>
      </view>
      
      <view class="question-content">
        <text class="question-text">{{currentQuestion.question}}</text>
      </view>

      <!-- 选项（单选/多选） -->
      <view wx:if="{{currentQuestion.type === 'single_choice' || currentQuestion.type === 'multiple_choice'}}" class="options-container">
        <view 
          wx:for="{{currentQuestion.options}}" 
          wx:key="index"
          class="option-item {{(currentQuestion.type === 'single_choice' && selectedOption === item) || (currentQuestion.type === 'multiple_choice' && selectedOptions.includes(item)) ? 'selected' : ''}}"
          bindtap="handleOptionTap"
          data-option="{{item}}"
        >
          <view class="option-radio">
            <view class="radio-inner {{(currentQuestion.type === 'single_choice' && selectedOption === item) || (currentQuestion.type === 'multiple_choice' && selectedOptions.includes(item)) ? 'checked' : ''}}"></view>
          </view>
          <text class="option-text">{{item}}</text>
        </view>
      </view>

      <!-- 填空题输入 -->
      <view wx:elif="{{currentQuestion.type === 'fill_blank'}}" class="fill-blank-container">
        <input 
          class="answer-input" 
          placeholder="请输入答案"
          value="{{userAnswer}}"
          bindinput="onAnswerInput"
        />
      </view>

      <!-- 答案解释 -->
      <view wx:if="{{showExplanation}}" class="explanation-container">
        <view class="explanation-header">
          <text class="explanation-title">答案解释</text>
        </view>
        <view class="explanation-content">
          <text class="explanation-text">{{currentQuestion.explanation}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button 
        wx:if="{{!showExplanation}}" 
        class="submit-answer-btn" 
        bindtap="submitAnswer"
        loading="{{submitting}}"
      >
        提交答案
      </button>
      
      <button 
        wx:elif="{{currentQuestionIndex < totalQuestions - 1}}" 
        class="next-question-btn" 
        bindtap="nextQuestion"
      >
        下一题
      </button>
      
      <button 
        wx:elif="{{showResult}}" 
        class="submit-quiz-btn" 
        bindtap="submitQuiz"
        loading="{{submitting}}"
      >
        完成练习
      </button>
    </view>

    <!-- 导航按钮 -->
    <view class="navigation-buttons">
      <button 
        wx:if="{{currentQuestionIndex > 0}}" 
        class="nav-btn prev-btn" 
        bindtap="prevQuestion"
      >
        上一题
      </button>
      
      <button 
        wx:if="{{currentQuestionIndex < totalQuestions - 1 && !showExplanation}}" 
        class="nav-btn next-btn" 
        bindtap="nextQuestion"
      >
        下一题
      </button>
    </view>
  </view>

  <!-- 完成状态 -->
  <view wx:elif="{{isCompleted}}" class="quiz-completed">
    <view class="completion-header">
      <view class="completion-icon">🎉</view>
      <text class="completion-title">练习完成！</text>
    </view>
    
    <view class="score-summary">
      <view class="score-item">
        <text class="score-label">得分</text>
        <text class="score-value">{{score}}/{{totalScore}}</text>
      </view>
      <view class="score-item">
        <text class="score-label">正确率</text>
        <text class="score-value">{{percentage.toFixed(1)}}%</text>
      </view>
      <view class="score-item">
        <text class="score-label">正确题数</text>
        <text class="score-value">{{correctCount}}/{{totalQuestions}}</text>
      </view>
    </view>
    
    <view class="completion-actions">
      <button class="action-btn view-detail-btn" bindtap="showQuizResult">
        查看详情
      </button>
      <button class="action-btn retry-btn" bindtap="retryQuiz">
        重新练习
      </button>
    </view>
  </view>
</view>