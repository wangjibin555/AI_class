/* pages/quiz/quiz.wxss */

.quiz-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ffffff30;
  border-top: 6rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 练习信息 */
.quiz-info {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.quiz-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.quiz-title {
  font-size: 28rpx;
  color: #666666;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 600;
}

.quiz-details {
  margin-bottom: 30rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.label {
  color: #666666;
  font-size: 28rpx;
}

.value {
  color: #333333;
  font-size: 28rpx;
  font-weight: 500;
}

.quiz-description {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.quiz-description text {
  color: #666666;
  font-size: 28rpx;
  line-height: 1.6;
}

.start-button-container {
  text-align: center;
}

.start-button {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.start-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 答题界面 */
.quiz-interface {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.quiz-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 500;
}

.time-text {
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.question-container {
  padding: 40rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.question-type {
  background: #e3f2fd;
  color: #1976d2;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.question-content {
  margin-bottom: 40rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.6;
  font-weight: 500;
}

/* 选项样式 */
.options-container {
  margin-bottom: 40rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item.selected {
  background: #e3f2fd;
  border-color: #1976d2;
}

.option-item:active {
  transform: scale(0.98);
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #cccccc;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.option-item.selected .option-radio {
  border-color: #1976d2;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.3s ease;
}

.radio-inner.checked {
  background: #1976d2;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

/* 填空题样式 */
.fill-blank-container {
  margin-bottom: 40rpx;
}

.answer-input {
  width: 100%;
  padding: 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #ffffff;
  transition: border-color 0.3s ease;
}

.answer-input:focus {
  border-color: #1976d2;
}

/* 答案解释 */
.explanation-container {
  background: #f3e5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  border-left: 6rpx solid #9c27b0;
}

.explanation-header {
  margin-bottom: 20rpx;
}

.explanation-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #9c27b0;
}

.explanation-content {
  background: #ffffff;
  padding: 20rpx;
  border-radius: 8rpx;
}

.explanation-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 操作按钮 */
.action-buttons {
  padding: 0 40rpx 40rpx;
}

.submit-answer-btn,
.next-question-btn,
.submit-quiz-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.submit-answer-btn:active,
.next-question-btn:active,
.submit-quiz-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 导航按钮 */
.navigation-buttons {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx 40rpx;
}

.nav-btn {
  background: #f8f9fa;
  color: #666666;
  border: 2rpx solid #e0e0e0;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.nav-btn:active {
  background: #e9ecef;
  transform: translateY(1rpx);
}

/* 完成状态 */
.quiz-completed {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  margin: 20rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.completion-header {
  margin-bottom: 40rpx;
}

.completion-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.completion-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.score-summary {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
}

.score-item {
  text-align: center;
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.score-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #1976d2;
}

.completion-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.view-detail-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.retry-btn {
  background: #ffffff;
  color: #667eea;
  border: 2rpx solid #667eea;
}

.view-detail-btn:active,
.retry-btn:active {
  transform: translateY(2rpx);
}