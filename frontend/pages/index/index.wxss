/* 首页样式 */
.container { min-height: 100vh; background: #f7f8fc; padding: 20rpx; }

/* 顶部综合卡片（仿图一排布） */
.home-card { position: relative; overflow: hidden; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.06); padding-bottom: 28rpx; margin-bottom: 24rpx; }
.hero-illustration { width: 100%; height: 320rpx; background: #f3f5f9; display: block; }
.home-title { display:block; text-align:center; font-size: 52rpx; font-weight: 800; color:#1f2937; margin-top: 16rpx; }
.home-subtitle { display:block; text-align:center; font-size: 28rpx; color:#6b7280; margin-top: 8rpx; }

.welcome-card { display:none; }
.home-card .welcome-title { font-size: 36rpx; font-weight: 700; color:#111827; display:block; margin: 28rpx 0 8rpx; text-align:center; }
.home-card .welcome-desc { font-size: 28rpx; color:#6b7280; display:block; margin-bottom: 24rpx; text-align:center; }

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 30rpx;
}

.login-status { margin: 20rpx auto; padding: 20rpx; background: #f7f7fb; border-radius: 12rpx; color: #374151; width: 88%; text-align: center; }

.login-status text {
  font-size: 28rpx;
  color: #333;
}

.primary-btn { width: 260rpx; height: 84rpx; background: linear-gradient(135deg,#5b8cff,#7c5cff); color:#fff; border-radius: 44rpx; font-size: 30rpx; display:flex; align-items:center; justify-content:center; margin: 20rpx auto; }
.primary-btn::after { border: none; }

.function-menu { background: #fff; border-radius: 20rpx; padding: 36rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06); margin-top: 20rpx; }

.menu-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }

.menu-item { background:#f8fafc; border-radius:16rpx; padding:40rpx 20rpx; text-align:center; border:2rpx solid transparent; transition: all .2s ease; }
.menu-item:active { transform: scale(0.96); background:#eef2ff; }
.menu-icon { display:block; font-size:40rpx; margin-bottom:12rpx; }

.menu-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
} 