/* pages/course/list/list.wxss */

/* 页面容器 */
.page-container {
  background: linear-gradient(180deg, #4D7CFE 0%, #6A5EFF 100%);
  min-height: 100vh;
}

/* 导航栏 */
.nav-header {
  background: linear-gradient(180deg, #4D7CFE 0%, #6A5EFF 100%);
  padding: 20rpx 30rpx 40rpx 30rpx;
  padding-top: calc(var(--status-bar-height) + 20rpx);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: white;
  font-size: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-action-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: white;
  font-size: 28rpx;
}

.container {
  padding: 20rpx;
  background-color: #F5F7FA;
  min-height: calc(100vh - 140rpx);
  padding-bottom: 140rpx; /* 为底部浮动按钮预留空间 */
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
  gap: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F8F9FB;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
}

.search-input::placeholder {
  color: #666;
}

.search-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-btn, .clear-btn {
  width: 48rpx;
  height: 48rpx;
  border: none;
  border-radius: 50%;
  background: transparent;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.search-btn {
  color: #4D7CFE;
}

.clear-btn {
  color: #999;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 24rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(77, 124, 254, 0.3);
  backdrop-filter: blur(10rpx);
}

.filter-btn:disabled {
  background: rgba(255, 255, 255, 0.5);
  color: #999;
  box-shadow: none;
}

.filter-icon {
  font-size: 24rpx;
}

/* 搜索历史样式 */
.search-history {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
  max-height: 400rpx;
  overflow-y: auto;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.clear-history-btn {
  font-size: 24rpx;
  color: #999;
  background: none;
  border: none;
  padding: 0;
}

.history-list {
  padding: 0 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.history-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.history-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

/* 加载状态样式 */
.search-loading {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #4D7CFE;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 课件类型切换标签 */
.course-type-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  margin: 0 20rpx 20rpx 20rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #666;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item.active {
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(77, 124, 254, 0.4);
}

.tab-item:not(.active):hover {
  background: rgba(77, 124, 254, 0.1);
}

/* 筛选器 */
.filters {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.filters.show {
  max-height: 500rpx;
  padding: 20rpx;
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
}

.filter-options {
  display: flex;
  white-space: nowrap;
}

.filter-option {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #F8F9FB;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 15rpx;
  transition: all 0.3s;
}

.filter-option.active {
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(77, 124, 254, 0.3);
}

.sort-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

/* 课程统计 */
.course-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.stats-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 课程列表 */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 20rpx;
  background: transparent;
}

/* 课程卡片 */
.course-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12), 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
  overflow: hidden;
}

.course-card:active {
  transform: translateY(-4rpx) scale(0.98);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.16), 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.course-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #4D7CFE 0%, #6A5EFF 50%, #4D7CFE 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.course-card:hover::before {
  opacity: 1;
}

/* 标题区域 */
.title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.course-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}

.course-status {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: white;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10rpx);
}

.status-generating {
  background: linear-gradient(135deg, #FF9500 0%, #FFB340 100%);
}

.status-completed {
  background: linear-gradient(135deg, #28A745 0%, #34CE57 100%);
}

.status-failed {
  background: linear-gradient(135deg, #DC3545 0%, #E74C3C 100%);
}

/* 链接区域 */
.link-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, rgba(77, 124, 254, 0.08) 0%, rgba(106, 94, 255, 0.06) 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #4D7CFE;
  box-shadow: 0 2rpx 8rpx rgba(77, 124, 254, 0.1);
  backdrop-filter: blur(10rpx);
}

.course-link {
  font-size: 24rpx;
  color: #4D7CFE;
  font-weight: 600;
}

.course-url {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
  font-weight: 500;
}

/* 课程描述 */
.course-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 第一行数据 */
.stats-row-1 {
  display: flex;
  gap: 80rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: rgba(248, 249, 251, 0.8);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.stats-row-1 .stat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 12rpx;
  background: white;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  flex: 1;
  justify-content: center;
}

.stat-icon {
  font-size: 28rpx;
  opacity: 0.8;
}

.stat-number {
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}



/* 时间区域 */
.time-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, rgba(248, 249, 251, 0.6) 0%, rgba(255, 255, 255, 0.4) 100%);
  border-radius: 12rpx;
  border-top: 2rpx solid rgba(77, 124, 254, 0.1);
  backdrop-filter: blur(5rpx);
}

.time-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-item::before {
  content: '•';
  color: #4D7CFE;
  font-weight: bold;
  font-size: 20rpx;
}



/* 加载更多 */
.load-more {
  text-align: center;
  margin-top: 30rpx;
}

.load-more-btn {
  padding: 20rpx 40rpx;
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(77, 124, 254, 0.3);
}

.load-more-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  margin-top: 30rpx;
  padding: 20rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.create-btn {
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  border-radius: 25rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(77, 124, 254, 0.3);
}

/* 筛选器操作按钮 */
.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.reset-btn, .apply-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.reset-btn {
  background: #F8F9FB;
  color: #666;
}

.apply-btn {
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(77, 124, 254, 0.3);
}

/* 浮动创建按钮 */
.fab-container {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  z-index: 1000;
}

.fab-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #4D7CFE 0%, #6A5EFF 100%);
  color: white;
  font-size: 48rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(77, 124, 254, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.fab-btn:active {
  transform: scale(0.95);
}

.fab-icon {
  line-height: 1;
}

/* 移除不需要的样式 */
.course-thumbnail, .thumbnail-image, .course-tags, .tag, .course-stats-row, .course-meta, .meta-item {
  display: none;
}