/* pages/course/create/create.wxss */

/* 整体容器优化 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg,rgb(121, 107, 232) 0%, #74B9FF 50%,rgb(214, 224, 238) 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.content-wrapper {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
  animation: containerFadeIn 0.6s ease-out;
}

@keyframes containerFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 页面标题优化 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(102, 126, 234, 0.1);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.page-subtitle {
  font-size: 24rpx;
  color: #666666;
  opacity: 0.8;
}

/* 🆕 简化的生成中加载条 */
.generating-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin: 0 -40rpx 32rpx -40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.generating-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.generating-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(45deg, #667eea, #764ba2);
  animation: dotPulse 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 输入方式选择优化 */
.input-methods {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
  background: rgba(102, 126, 234, 0.05);
  padding: 16rpx;
  border-radius: 20rpx;
}

.input-method {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.8);
  color: #666666;
  transition: all 0.3s ease;
  cursor: pointer;
}

.input-method.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.input-method:hover:not(.active) {
  background: rgba(255, 255, 255, 1);
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 内容区域 */
.content-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

/* URL输入区域优化 */
.url-input-group {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  background-clip: padding-box;
  transition: all 0.3s ease;
}

.url-input-group:focus-within {
  border-color: #667eea;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  transform: translateY(-2rpx);
}

.url-input {
  flex: 1;
  padding: 20rpx 24rpx;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.8);
  color: #333333;
  min-height: 80rpx;
  max-height: 200rpx;
  transition: all 0.3s ease;
  resize: none;
}

.url-input:focus {
  outline: none;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.1);
}

.input-placeholder {
  color: #999999;
  font-size: 26rpx;
  opacity: 0.8;
}



/* 🆕 URL平台识别样式 */
.platform-detection {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #e8f2ff 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.1);
  animation: slideInDown 0.3s ease-out;
}

.platform-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.platform-icon {
  font-size: 32rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.platform-details {
  flex: 1;
}

.platform-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.platform-description {
  font-size: 24rpx;
  color: #666666;
  opacity: 0.8;
}

.platform-confidence {
  display: flex;
  align-items: center;
}

.confidence-high {
  color: #52c41a;
  font-size: 24rpx;
  font-weight: bold;
}

/* 🆕 URL验证错误和警告样式 */
.url-validation-errors {
  margin-top: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #ff4d4f;
  animation: slideInUp 0.3s ease-out;
}

.url-validation-warnings {
  margin-top: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fffbf0 0%, #fff7e6 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #faad14;
  animation: slideInUp 0.3s ease-out;
}

.error-item, .warning-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.error-item:last-child, .warning-item:last-child {
  margin-bottom: 0;
}

.error-icon, .warning-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  line-height: 1.4;
}

.warning-text {
  font-size: 24rpx;
  color: #fa8c16;
  line-height: 1.4;
}

/* 验证按钮错误状态 */
.validate-btn-error {
  background: linear-gradient(135deg, #ff7875 0%, #ff4d4f 100%) !important;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.3) !important;
}

/* 🆕 通用动画效果 */
@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes bounce {
  0%, 20%, 53%, 80%, 100% {
    transform: translate3d(0,0,0);
  }
  40%, 43% {
    transform: translate3d(0, -6rpx, 0);
  }
  70% {
    transform: translate3d(0, -3rpx, 0);
  }
  90% {
    transform: translate3d(0, -1rpx, 0);
  }
}

/* 响应式设计优化 */
@media (max-width: 750rpx) {
  .platform-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .progress-steps {
    max-height: 150rpx;
  }
  
  .step-label {
    font-size: 20rpx;
  }
}

/* 课件配置区域优化 */
.form-section {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 32rpx 0;
  border: 2rpx solid rgba(102, 126, 234, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.form-section .section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(102, 126, 234, 0.1);
}

.form-section .section-title::before {
  content: "📋";
  font-size: 28rpx;
  margin-right: 12rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #555555;
  margin-bottom: 16rpx;
}

.form-label .required {
  color: #e74c3c;
  margin-left: 8rpx;
  font-weight: 700;
}

/* 课件标题输入框优化 */
.form-input {
  width: 100%;
  min-height: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #ffffff;
  color: #333333;
  transition: all 0.3s ease;
  box-sizing: border-box;
  display: block;
  overflow: visible;
}

.form-input:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
  background: #fafafa;
}

.form-input::placeholder {
  color: #adb5bd;
  font-size: 28rpx;
  line-height: 80rpx;
  padding-left: 2rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.form-textarea {
  min-height: 180rpx;
  max-height: 400rpx;
  resize: vertical;
  line-height: 1.6;
}

/* 生成状态指示器 */
.generation-status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
  padding: 20rpx;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(33, 150, 243, 0.2);
}

.status-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  animation: statusPulse 1.5s infinite;
}

@keyframes statusPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1976d2;
}

/* 文件上传相关 */
.file-info {
  margin-top: 20rpx;
  padding: 25rpx;
  background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
  border-radius: 12rpx;
  border: 2rpx solid #b3d9ff;
}

.file-details {
  margin-bottom: 20rpx;
}

.file-details text {
  display: block;
  font-size: 26rpx;
  color: #1e40af;
  margin-bottom: 10rpx;
}

.file-details text:last-child {
  margin-bottom: 0;
}

/* 上传进度样式 */
.upload-progress {
  margin: 20rpx 0;
  padding: 15rpx;
  background: rgba(79, 70, 229, 0.05);
  border-radius: 8rpx;
  border: 1rpx solid rgba(79, 70, 229, 0.2);
}

.progress-text {
  font-size: 24rpx;
  color: #4f46e5;
  text-align: center;
  margin-bottom: 10rpx;
}

.progress-bar-container {
  width: 100%;
  height: 8rpx;
  background: rgba(79, 70, 229, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 文件操作按钮样式 */
.file-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.upload-file-btn {
  width: 100%;
  padding: 25rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.3);
}

.upload-file-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(16, 185, 129, 0.4);
}

.upload-success {
  text-align: center;
  font-size: 26rpx;
  color: #10b981;
  font-weight: bold;
  padding: 10rpx;
}

.remove-file-btn {
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 24rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 15rpx rgba(239, 68, 68, 0.3);
}

.remove-file-btn:active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}

.upload-btn {
  width: 100%;
  padding: 35rpx;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: white;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 25rpx;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 25rpx rgba(79, 70, 229, 0.3);
  position: relative;
  overflow: hidden;
}

.upload-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.upload-btn:active::before {
  left: 100%;
}

.upload-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(79, 70, 229, 0.4);
}

/* AI生成模式选择 - 优化样式 */
.generation-mode-section {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.generation-mode-section .section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 模式选择按钮 */
.mode-buttons-container {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mode-button {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 0;
  margin: 0;
  overflow: visible;
  position: relative;
  transition: all 0.3s ease;
}

.mode-button::after {
  border: none;
}

.mode-button.active {
  background: rgba(255, 255, 255, 0.95);
  border-color: rgba(255, 255, 255, 0.8);
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.button-content {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  min-height: 80rpx;
}

.button-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.button-text {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.button-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.mode-button.active .button-title {
  color: #333333;
}

.button-badge {
  background: linear-gradient(45deg, #ff6b6b, #feca57);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.mode-button.active .button-badge {
  background: linear-gradient(45deg, #667eea, #764ba2);
}

/* 模式描述卡片 */
.mode-description {
  margin-bottom: 24rpx;
}

.description-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 24rpx;
  animation: fadeInUp 0.4s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.card-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.feature-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  color: #ffffff;
}

.feature-tag.feature-primary {
  background: linear-gradient(45deg, #667eea, #764ba2);
}

.feature-tag.feature-success {
  background: linear-gradient(45deg, #56ab2f, #a8e6cf);
}

.feature-tag.feature-info {
  background: linear-gradient(45deg, #3498db, #74b9ff);
}

.feature-tag.feature-warning {
  background: linear-gradient(45deg, #f39c12, #f1c40f);
}

/* AI引擎选择 */
.engine-selection {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.engine-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.engine-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.engine-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.engine-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.engine-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  transition: all 0.3s ease;
}

.engine-option.active {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.4);
  transform: scale(1.02);
}

.engine-option.disabled {
  opacity: 0.6;
}

.engine-info {
  flex: 1;
}

.engine-name {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  display: block;
  margin-bottom: 4rpx;
}

.engine-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.engine-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.engine-status.online .status-dot {
  background: #2ecc71;
  box-shadow: 0 0 12rpx rgba(46, 204, 113, 0.6);
}

.engine-status.coming .status-dot {
  background: #f39c12;
  box-shadow: 0 0 12rpx rgba(243, 156, 18, 0.6);
}

.status-text {
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

/* 操作按钮优化样式 */
.action-section {
  margin: 40rpx 0;
  padding: 0 32rpx;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  margin-bottom: 24rpx;
}

.submit-btn::after {
  border: none;
}

/* AI增强模式按钮样式 */
.submit-btn.ai-enhanced {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.submit-btn.ai-enhanced:not([disabled]):hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.5);
}

.submit-btn.ai-enhanced[disabled] {
  background: linear-gradient(135deg, #a8a8a8 0%, #8a8a8a 100%);
  box-shadow: none;
}

/* 传统模式按钮样式 */
.submit-btn.traditional {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.4);
}

.submit-btn.traditional:not([disabled]):hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(240, 147, 251, 0.5);
}

.submit-btn.traditional[disabled] {
  background: linear-gradient(135deg, #a8a8a8 0%, #8a8a8a 100%);
  box-shadow: none;
}

/* 按钮内容 */
.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
}

/* 按钮动画效果 */
.submit-btn:not([disabled]) {
  animation: buttonPulse 2s infinite;
}

@keyframes buttonPulse {
  0% {
    box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  }
  50% {
    box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.6);
  }
  100% {
    box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  }
}

.submit-btn.traditional:not([disabled]) {
  animation: buttonPulseTraditional 2s infinite;
}

@keyframes buttonPulseTraditional {
  0% {
    box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.4);
  }
  50% {
    box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.6);
  }
  100% {
    box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.4);
  }
}

/* 提示信息 */
.action-tips {
  text-align: center;
}

.action-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.02);
  margin-bottom: 16rpx;
}

.action-tip.processing {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  color: #8B4513;
  animation: processingPulse 1.5s infinite;
}

@keyframes processingPulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.8;
  }
}

.processing-dot {
  width: 8rpx;
  height: 8rpx;
  background: #ff9500;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: dotBounce 1.4s infinite;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.8);
  }
  40% {
    transform: scale(1.2);
  }
}

.action-tip.success {
  background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
  color: #155724;
}

.success-icon {
  margin-right: 8rpx;
  animation: successBounce 0.6s ease-out;
}

@keyframes successBounce {
  0% {
    transform: scale(0.3);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

.action-tip.analyzing {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  color: #0d47a1;
}

.analyzing-icon {
  margin-right: 8rpx;
  animation: robotThinking 2s infinite;
}

@keyframes robotThinking {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-10deg);
  }
  75% {
    transform: rotate(10deg);
  }
}

/* 加载状态的按钮样式 */
.submit-btn[loading] .btn-content {
  opacity: 0.8;
}

.submit-btn[disabled] {
  opacity: 0.6;
  transform: none !important;
  cursor: not-allowed;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .mode-buttons-container {
    flex-direction: column;
  }
  
  .feature-tags {
    justify-content: center;
  }
  
  .engine-option {
    flex-direction: column;
    align-items: flex-start;
    gap: 12rpx;
  }
  
  .engine-status {
    align-self: flex-end;
  }
  
  .submit-btn {
    height: 88rpx;
    font-size: 28rpx;
  }
  
  .btn-icon {
    font-size: 32rpx;
    margin-right: 12rpx;
  }
  
  .btn-text {
    font-size: 28rpx;
  }
  
  .action-tip {
    font-size: 22rpx;
    padding: 12rpx;
  }
}

/* 悬浮效果 */
.mode-button:hover {
  transform: translateY(-2rpx);
}

.mode-button.active:hover {
  transform: translateY(-6rpx);
}

.engine-option:not(.disabled):hover {
  background: rgba(255, 255, 255, 0.15);
}

/* 加载动画 */
.generation-mode-section {
  animation: slideInFromTop 0.5s ease-out;
}

@keyframes slideInFromTop {
  from {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 表单提示样式 */
.form-tip {
  display: flex;
  align-items: flex-start;
  background: rgba(102, 126, 234, 0.08);
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  animation: tipFadeIn 0.3s ease-out;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  flex: 1;
}

.section-title .title-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.section-title .title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

@keyframes tipFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 🆕 再次生成按钮样式 */
.regenerate-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: regenerateSlideIn 0.5s ease-out;
}

@keyframes regenerateSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.regenerate-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.regenerate-btn::after {
  border: none;
}

/* 主要再次生成按钮 */
.regenerate-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  margin-bottom: 8rpx;
}

.regenerate-btn.primary:hover {
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 25rpx rgba(102, 126, 234, 0.4);
}

.regenerate-btn.primary:active {
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

/* 次要快速重新生成按钮 */
.regenerate-btn.secondary {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.1);
}

.regenerate-btn.secondary:hover {
  background: rgba(102, 126, 234, 0.15);
  border-color: rgba(102, 126, 234, 0.3);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.15);
}

.regenerate-btn.secondary:active {
  transform: translateY(0);
  background: rgba(102, 126, 234, 0.2);
}

/* 再次生成按钮内容 */
.regenerate-btn .btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 12rpx;
}

.regenerate-btn .btn-icon {
  font-size: 28rpx;
}

.regenerate-btn .btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* 🆕 再次生成按钮动画效果 */
.regenerate-btn.primary {
  animation: regeneratePulse 2.5s infinite;
}

@keyframes regeneratePulse {
  0% {
    box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  }
  50% {
    box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.5);
  }
  100% {
    box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  }
}

/* 响应式优化 */
@media (max-width: 750rpx) {
  .regenerate-section {
    gap: 12rpx;
  }
  
  .regenerate-btn {
    height: 80rpx;
    font-size: 26rpx;
  }
  
  .regenerate-btn .btn-icon {
    font-size: 26rpx;
  }
  
  .regenerate-btn .btn-text {
    font-size: 26rpx;
  }
}