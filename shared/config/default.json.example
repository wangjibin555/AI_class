{
  "services": {
    "gateway": {
      "port": 3000,
      "host": "0.0.0.0"
    },
    "upload": {
      "port": 3001,
      "maxFileSize": "50MB"
    },
    "parse": {
      "port": 3002
    },
    "chunk": {
      "port": 3003
    },
    "pptGen": {
      "port": 3004
    },
    "file": {
      "port": 3005
    },
    "auth": {
      "port": 3006,
      "jwtSecret": "${JWT_SECRET:-your-secret-key-change-in-production}",
      "jwtExpiry": "7d"
    }
  },
  "infrastructure": {
    "postgres": {
      "host": "localhost",
      "port": 5432,
      "database": "doc2ppt",
      "user": "${DB_USER:-admin}",
      "password": "${DB_PASSWORD:-changeme}"
    },
    "redis": {
      "host": "localhost",
      "port": 6379
    },
    "rabbitmq": {
      "host": "localhost",
      "port": 5672,
      "user": "${RABBITMQ_USER:-admin}",
      "password": "${RABBITMQ_PASSWORD:-changeme}",
      "queues": {
        "parse": "doc-parse-queue",
        "chunk": "doc-chunk-queue",
        "generate": "ppt-generate-queue"
      }
    },
    "minio": {
      "endpoint": "localhost",
      "port": 9000,
      "accessKey": "${MINIO_ACCESS_KEY:-admin}",
      "secretKey": "${MINIO_SECRET_KEY:-changeme}",
      "buckets": {
        "documents": "documents",
        "presentations": "presentations"
      }
    }
  },
  "limits": {
    "maxFileSize": 52428800,
    "supportedFormats": ["docx", "pdf", "md", "txt"],
    "maxPagesPerPPT": 100
  }
}













